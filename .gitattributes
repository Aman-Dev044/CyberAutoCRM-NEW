# Normalise line endings so Windows and Linux checkouts stay identical.
* text=auto eol=lf

# Keep shell scripts LF even on Windows checkouts.
*.sh text eol=lf

# Windows-only files stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never touch, never diff.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated lockfile: collapse it in PR diffs.
package-lock.json linguist-generated=true -diff
