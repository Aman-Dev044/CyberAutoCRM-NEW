# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/cyberautocrm-Ai
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cyberautocrm-Ai?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cyberautocrm-Ai?retryWrites=true&w=majority"

# ---- Auth ----
# openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# The session cookie is marked `Secure` in production, which browsers only
# store over HTTPS. If you are serving over plain HTTP (http://IP:PORT), set
# this to false or nobody will be able to stay logged in. Turn it back on
# the moment TLS is in front of the app.
COOKIE_SECURE="true"

# ---- App ----
NEXT_PUBLIC_APP_NAME="CyberAutoSuite"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Split-port deployment (optional) ----
# Next.js serves the UI and /api from ONE process, so by default leave both of
# these empty. Set them only when you run the API as a second instance on
# another port — e.g. API on :2442 and the web UI on :2552.
#
#   NEXT_PUBLIC_API_BASE="http://YOUR_VPS_IP:2442"
#   CORS_ALLOWED_ORIGINS="http://YOUR_VPS_IP:2552"
#
# Cookies are scoped per host and ignore the port, so the session survives the
# split; CORS still has to be allowed because the origin includes the port.
NEXT_PUBLIC_API_BASE=""
CORS_ALLOWED_ORIGINS=""

# ---- Seed superadmin ----
SEED_SUPERADMIN_EMAIL="superadmin@cyberautosuite.com"
SEED_SUPERADMIN_PASSWORD="SuperAdmin@123"
