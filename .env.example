# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/cyberautocrm-Ai
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cyberautocrm-Ai?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cyberautocrm-Ai?retryWrites=true&w=majority"

# ---- Auth ----
# openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ---- App ----
NEXT_PUBLIC_APP_NAME="CyberAutoSuite"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Seed superadmin ----
SEED_SUPERADMIN_EMAIL="superadmin@cyberautosuite.com"
SEED_SUPERADMIN_PASSWORD="SuperAdmin@123"
